# Supabase project connection (public/client-safe values only).
#
# These are read at build time by Vite and end up in the browser bundle —
# that is expected and safe: the anon key can only do what Row Level
# Security on the database explicitly allows. Never put the
# service_role key, database password, or JWT secret in this file or
# anywhere in frontend code.
#
# Find these values in your Supabase project: Project Settings -> API.
VITE_SUPABASE_URL="https://YOUR-PROJECT-REF.supabase.co"
VITE_SUPABASE_ANON_KEY="YOUR-PUBLIC-ANON-KEY"
